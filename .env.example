# Required for live generation. Do not commit your real key.
OPENAI_API_KEY=

# OpenAI models (current defaults as of Aug 2026)
TEXT_MODEL=gpt-5.6-luna
IMAGE_MODEL=gpt-image-2

# Cost / quality controls
IMAGE_QUALITY=low
IMAGE_GENERATION_SIZE=1024x1536
CONCEPT_COUNT=12
OUTPUT_POST_COUNT=3

# Editorial / runtime behaviour
USE_WEB_CONTEXT=true
MOCK_OPENAI=false
UK_REGION=United Kingdom
ACCOUNT_HANDLE=@yourhandle

# Optional HTTP Basic Auth. Set both before exposing HEX outside your trusted LAN.
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=

# Native daily draft preparation. This generates TEXT drafts only; images still require approval.
AUTO_PREPARE_ENABLED=false
AUTO_PREPARE_TIME=07:00
AUTO_PREPARE_TIMEZONE=Europe/London
AUTO_PREPARE_WEB_CONTEXT=true
AUTO_PREPARE_MOCK=false

# Storage
OUTPUT_DIR=./output
DATABASE_PATH=./data/content_factory.sqlite3
